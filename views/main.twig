{% extends "__layout.twig" %}

{% block content %}
<div class="container py-4">
    <h1 class="display-6 fw-bold text-center mb-4">Games</h1>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        {% for game in games %}
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="ratio ratio-16x9">
                    <img
                        class="w-100 h-100 object-fit-cover"
                        src="{{ game.image }}"
                        alt="{{ game.title }}"
                    >
                </div>
                <div class="card-body d-flex flex-column">
                    <ul class="nav nav-pills mb-2">
                        <li class="nav-item w-100">
                            <a class="nav-link active w-100 text-center"
                                aria-current="page"
                                href="/games/{{ game.id }}">
                                {{ game.title }}
                            </a>
                        </li>
                    </ul>
                    <ul class="nav nav-pills">
                        <li class="nav-item flex-fill">
                            <a class="nav-link w-100 text-center"
                                href="/games/{{ game.id }}?show=image">
                                Image
                            </a>
                        </li>
                        <li class="nav-item flex-fill">
                            <a class="nav-link w-100 text-center"
                                href="/games/{{ game.id }}?show=description">
                                Description
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex gap-2 mt-auto pt-3">
                        <a class="btn btn-warning btn-sm w-100"
                            href="/games/{{ game.id }}/edit">
                            Edit
                        </a>
                        <form method="post" action="/games/delete/{{ game.id }}"
                            class="w-100"
                            onsubmit="return confirm('Delete this game?')"
                        >
                            <button type="submit" class="btn btn-danger btn-sm w-100">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <p class="text-center text-muted">No games found.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
