{% extends "game.twig" %}

{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <p class="lead text-body-secondary">
                {{ game.description }}
            </p>
            {% if game.info %}
            <p class="text-body-secondary mb-0">
                {{ game.info }}
            </p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
