{% extends '__layout.twig' %}

{% block content %}
    <div class="container py-4">
        <h1 class="display-6 fw-bold text-center mb-4">Search</h1>

        <form
            method="get"
            action="/search"
            class="row g-3 align-items-end mb-4"
        >
            <div class="col-12 col-md-4">
                <label for="type" class="form-label">Type</label>
                <select class="form-select" id="type" name="type">
                    <option
                        value=""
                        {{ selected_search_type_id is null ? 'selected' }}
                    >
                        All
                    </option>
                    {% for type in types %}
                        <option
                            value="{{ type.id }}"
                            {{ selected_search_type_id == type.id ? 'selected' }}
                        >
                            {{ type.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label for="title" class="form-label">Name</label>
                <input
                    class="form-control"
                    type="text"
                    id="title"
                    name="title"
                    value="{{ filters.title }}"
                />
            </div>
            <div class="col-12 col-md-4">
                <label for="description" class="form-label">Description</label>
                <input
                    class="form-control"
                    type="text"
                    id="description"
                    name="description"
                    value="{{ filters.description }}"
                />
            </div>
            <div class="col-12 d-flex gap-2">
                <button class="btn btn-primary" type="submit">Find</button>
                <a class="btn btn-outline-secondary" href="/search">Reset</a>
            </div>
        </form>

        <h2 class="h4 mb-3">Results</h2>
        <div class="list-group">
            {% for game in games %}
                <a
                    class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                    href="/games/{{ game.id }}"
                >
                    <span>{{ game.title }}</span>
                    <span class="badge text-bg-secondary">
                        {{ game.type }}
                    </span>
                </a>
            {% else %}
                <div class="list-group-item text-muted">
                    No games found.
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
